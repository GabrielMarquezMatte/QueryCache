<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>QueryCache.EFCore</PackageId>
    <Version>1.0.0</Version>
    <Authors>Gabriel Matte</Authors>
    <Description>Cache Entity Framework Core query results in-process or in any HybridCache, with IQueryable extensions (ToListCachedAsync, FirstOrDefaultCachedAsync, SumCachedAsync, ...).</Description>
    <PackageTags>cache;query;efcore;entity-framework</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/GabrielMarquezMatte/QueryCache</PackageProjectUrl>
    <RepositoryUrl>https://github.com/GabrielMarquezMatte/QueryCache</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright (c) Gabriel Matte</Copyright>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="QueryCache.Tests" />
    <InternalsVisibleTo Include="QueryCache.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QueryCache.Core\QueryCache.Core.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI\PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI\PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
