<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- BenchmarkDotNet needs public, non-sealed, instance benchmark classes and runs without a sync context. -->
    <!-- RS0016/RS0026/RS0037: public-API tracking is for the shipped packages under src/. -->
    <NoWarn>$(NoWarn);RS0016;RS0026;RS0037;CA1001;CA1515;CA1822;CA2007;CA2000;CA1707;CA1812;MA0004;MA0048;MA0038</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\QueryCache.EFCore\QueryCache.EFCore.csproj" />
    <ProjectReference Include="..\..\src\QueryCache.Dapper\QueryCache.Dapper.csproj" />
  </ItemGroup>

</Project>
